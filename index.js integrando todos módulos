const express = require("express");
const bodyParser = require("body-parser");

const app = express();
app.use(bodyParser.json());

// Importa os módulos
const modules = require("./módulos/modules");

// Usa os módulos
app.use("/", modules);

// Rota teste
app.get("/", (req, res) => {
  res.send("🚀 Mythra Backend rodando com sucesso!");
});

// Inicia servidor
const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
  console.log(`Mythra backend rodando na porta ${PORT}`);
});
