const express = require('express');
const bodyParser = require('body-parser');
const app = express();
app.use(bodyParser.json());

// ===================== IMPORTANDO MÓDULOS =====================
const modules = require('./modules/modules'); // seu modules.js com todos os módulos

// ===================== USANDO OS MÓDULOS =====================
app.use('/', modules);

// ===================== INICIANDO SERVIDOR =====================
const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
    console.log(`Mythra backend rodando na porta ${PORT}`);
});
